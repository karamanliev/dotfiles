# Generated by Noctalia. Edit its source template, not this file.
[delta]
    light = {{ mode | replace: "light", "true" | replace: "dark", "false" }}
    dark = {{ mode | replace: "dark", "true" | replace: "light", "false" }}
    syntax-theme = ansi

    minus-style = "syntax {{ colors.terminal_background.default.hex | auto_lightness 5 | set_saturation 40 | set_hue 5 }}"
    minus-emph-style = "syntax bold {{ colors.terminal_background.default.hex | auto_lightness 10 | set_saturation 50 | set_hue 5 }}"
    plus-style = "syntax {{ colors.terminal_background.default.hex | auto_lightness 5 | set_saturation 40 | set_hue 110 }}"
    plus-emph-style = "syntax bold {{ colors.terminal_background.default.hex | auto_lightness 10 | set_saturation 50 | set_hue 110 }}"
    zero-style = "syntax auto"

    line-numbers-minus-style = "{{ colors.terminal_normal_red.default.hex }} auto"
    line-numbers-plus-style = "{{ colors.terminal_normal_green.default.hex }} auto"
    line-numbers-zero-style = "{{ colors.on_surface_variant.default.hex }} auto"
    line-numbers-left-style = "{{ colors.on_surface_variant.default.hex }} auto"
    line-numbers-right-style = "{{ colors.on_surface_variant.default.hex }} auto"
    file-style = "bold {{ colors.on_surface.default.hex }}"
    hunk-header-style = "syntax"
    hunk-header-decoration-style = "{{ colors.primary.default.hex }} box"
