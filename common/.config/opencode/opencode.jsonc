{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "neuralwatt/deepseek-v4-flash-flex",
  "enabled_providers": [
    "openai",
    "opencode",
    "opencode-go",
    "google",
    "neuralwatt",
    "openrouter"
  ],
  "permission": {
    "websearch": "allow"
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "deja": {
      "type": "local",
      "command": [
        "deja",
        "mcp"
      ],
      "enabled": true
    }
  },
  "agent": {
    "explore": {
      "model": "neuralwatt/deepseek-v4-flash-flex",
      "variant": "max",
      "temperature": 0
    }
  },
  "compaction": {
    "auto": false
  },
  "share": "disabled",
  "plugin": [
    "cc-safety-net"
  ]
}
