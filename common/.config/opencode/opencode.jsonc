{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "neuralwatt/deepseek-v4-flash-flex",
  "enabled_providers": [
    "openai",
    "opencode",
    "opencode-go",
    "google",
    "neuralwatt",
    "openrouter"
  ],
  "permission": {
    "websearch": "allow"
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "deja": {
      "type": "local",
      "command": [
        "deja",
        "mcp"
      ],
      "enabled": true
    }
  },
  "compaction": {
    "auto": false
  },
  "share": "disabled",
  "plugins": [
    "cc-safety-net@latest"
  ],
  "agents": {
    "explore": {
      "model": "openai/gpt-6-luna",
      "mode": "subagent",
      "request": {
        "body": {
          "temperature": 0
        }
      }
    }
  }
}